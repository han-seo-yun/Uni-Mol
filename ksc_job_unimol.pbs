#!/bin/bash
# =============================================================================
# 이 시스템(KISTI Neuron)은 순수 Slurm이다. `qsub`는 sbatch를 그대로 호출만
# 하고 `#PBS` 지시어는 해석하지 않으므로(그냥 주석으로 무시됨) `#SBATCH`로 쓴다.
# (showappl 확인, 2026-08-21: --comment="field=<field>;appl=<program>" 필수)
# =============================================================================
#SBATCH --job-name=unimol_pretrain
#SBATCH --partition=amd_a100_4
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --gres=gpu:4
#SBATCH --time=24:00:00
#SBATCH --output=unimol_pretrain.log
#SBATCH --error=unimol_pretrain.log
#SBATCH --comment="field=chem;appl=pytorch"
#SBATCH --mail-user=hsy071322@naver.com
#SBATCH --mail-type=END,FAIL

# ↓ qsub가 "Account" 관련 에러로 거부되면 아래 주석을 풀고 본인 계정값 채울 것.
##SBATCH --account=etc

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

# 1) CUDA 모듈 로드
#    *** upstream README의 cuda/11.3 + torch==1.11.0+cu113 조합은 KSC에서 불가능하다. ***
#    module avail cuda 확인 결과(2026-08-13) KSC에는 12.1 ~ 13.0.2 만 있고 11.x 모듈이 없다.
#    따라서 cuda/12.1 + torch cu121 빌드 조합으로 올린다.
#    핵심 규칙은 그대로다: "module load한 CUDA major/minor == torch가 빌드된 CUDA".
#    Uni-Core를 --enable-cuda-ext 로 빌드할 때 setup.py가 이 둘을 비교해서
#    어긋나면 에러를 낸다.
#    (2026-08-22 smoke test 확인: cuda/12.1은 deprecated돼서 cuda/12.4.1로 자동
#    리다이렉트됨 -- torch가 cu121로 빌드돼 있어도 driver/toolkit 12.4는 상위
#    호환이라 문제 없음. 경고만 뜸.)
module load cuda/12.1

# *** 계산 노드에는 conda가 기본 PATH에 없다 (smoke test 확인, 2026-08-22:
# "conda 명령이 없음") -- KSC가 제공하는 conda 모듈을 먼저 load 해야 함.
module load conda/pytorch_2.9.1_cuda12
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate unimol

# 2) GPU 인식 확인
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), torch.cuda.device_count(), 'GPUs')"

# 3) Uni-Core가 --enable-cuda-ext 로 빌드됐는지 재확인 (로컬 CPU 빌드를 그대로
#    가져왔다면 여기서 다시 빌드해야 함 -- install.sh ksc 단계 5 참고)
python -c "
import unicore
print('unicore imported OK -- verify fused kernels were built with CUDA_HOME =', __import__('os').environ.get('CUDA_HOME'))
"

# 4) 실제 pretrain (n_gpu, data_path, --user-dir 등은 README.md 의 실제 예시로 교체)
#    *** data_path 는 아직 placeholder다. 실제 사전학습 데이터 경로로 반드시 교체할 것. ***
n_gpu=4
data_path=/path/to/unimol/pretrain/data   # TODO: 실제 데이터 경로로 교체

python -m torch.distributed.launch --nproc_per_node=$n_gpu \
  "$(which unicore-train)" "$data_path" \
  --user-dir ./unimol \
  --train-subset train --valid-subset valid \
  --num-workers 8 --ddp-backend=c10d \
  --task unimol --loss unimol --arch unimol_base \
  --fp16 \
  --save-dir ./checkpoints \
  --tensorboard-logdir ./tsb
