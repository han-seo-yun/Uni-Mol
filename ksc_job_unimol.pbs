#!/bin/bash
#PBS -N unimol_pretrain
#PBS -q amd_a100_4                  # qstat -Q 확인됨 (2026-08-13). A100 4장 노드 -- 3D 분자 pretrain은 V100보다 메모리 여유있는 A100 권장
#PBS -l select=1:ncpus=32:ngpus=4    # TODO: qstat -Qf amd_a100_4 로 노드당 ncpus/ngpus 비율, 최대 walltime 확인 후 조정
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o unimol_pretrain.log

set -euo pipefail
cd "$PBS_O_WORKDIR"

# 1) CUDA 모듈 로드
#    *** upstream README의 cuda/11.3 + torch==1.11.0+cu113 조합은 KSC에서 불가능하다. ***
#    module avail cuda 확인 결과(2026-08-13) KSC에는 12.1 ~ 13.0.2 만 있고 11.x 모듈이 없다.
#    따라서 cuda/12.1 + torch cu121 빌드 조합으로 올린다.
#    핵심 규칙은 그대로다: "module load한 CUDA major/minor == torch가 빌드된 CUDA".
#    Uni-Core를 --enable-cuda-ext 로 빌드할 때 setup.py가 이 둘을 비교해서
#    어긋나면 에러를 낸다.
module load cuda/12.1

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate unimol

# 2) GPU 인식 확인
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), torch.cuda.device_count(), 'GPUs')"

# 3) Uni-Core가 --enable-cuda-ext 로 빌드됐는지 재확인 (로컬 CPU 빌드를 그대로
#    가져왔다면 여기서 다시 빌드해야 함 -- install.sh ksc 단계 5 참고)
python -c "
import unicore
print('unicore imported OK -- verify fused kernels were built with CUDA_HOME =', __import__('os').environ.get('CUDA_HOME'))
"

# 4) 실제 pretrain (n_gpu, data_path, --user-dir 등은 README.md 의 실제 예시로 교체)
n_gpu=4
data_path=/path/to/unimol/pretrain/data   # TODO: 실제 데이터 경로로 교체

python -m torch.distributed.launch --nproc_per_node=$n_gpu \
  "$(which unicore-train)" "$data_path" \
  --user-dir ./unimol \
  --train-subset train --valid-subset valid \
  --num-workers 8 --ddp-backend=c10d \
  --task unimol --loss unimol --arch unimol_base \
  --fp16 \
  --save-dir ./checkpoints \
  --tensorboard-logdir ./tsb
